# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- app database (PostgreSQL 18; see README "Database") ---
DATABASE_URL=postgresql://food:food@127.0.0.1:5432/food_service

# --- accounts ---
# Secret key for hashing usernames (never change or lose it: every account would be locked out).
# Generate once with: openssl rand -hex 32
USERNAME_KEY=
# Invite code for /signup; empty = sign-up closed
SIGNUP_CODE=

# --- data source keys ---
SHELFATLAS_API_KEY=
# Nutrition uses a LOCAL USDA store (no API key). Download the Foundation + SR Legacy CSV
# zips from https://fdc.nal.usda.gov/download-datasets into ./usda/, then:
#   PYTHONPATH=. uv run python scripts/build_nutrition_db.py

# --- meal-plan agent (provider-agnostic; OpenAI-compatible /chat/completions) ---
# Point these three at ANY OpenAI-compatible provider — swap providers with no code change.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Provider presets (pick one; fill LLM_API_KEY with that provider's key):
#   Anthropic:      LLM_BASE_URL=https://api.anthropic.com/v1                            LLM_MODEL=claude-haiku-4-5
#   Gemini:         LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.5-flash
#   DeepSeek:       LLM_BASE_URL=https://api.deepseek.com                                LLM_MODEL=deepseek-chat
#   OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1                            LLM_MODEL=<any routed model>
#   Local (Ollama): LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=<local model>     LLM_API_KEY=ollama

# --- display translation (optional) ---
# Set a display language in Preferences to translate recipes/steps/shopping items. Uses the
# main LLM_* endpoint above by default; point these at a cheaper/different model instead:
# TRANSLATE_BASE_URL=
# TRANSLATE_MODEL=
# TRANSLATE_API_KEY=

# Optional: where the read-only USDA store lives (default: data/usda.db)
# USDA_DB_PATH=data/usda.db
